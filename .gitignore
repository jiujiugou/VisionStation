# Build outputs
bin/
obj/
publish/
*.user

# Visual Studio
.vs/

# Runtime data (created on first run)
visionstation.db
visionstation.db-shm
visionstation.db-wal
test_visionstation.db
test_visionstation.db-shm
test_visionstation.db-wal
*.db
*.db-shm
*.db-wal

Logs/
InspectedImages/
# VM「输出图像」模块的存图目录（VM 侧配置的落盘位置，几百张图几十 MB，不是源码）
VMOut/

# Crash / diagnostic logs
crash*.log
# VM SDK 崩溃现场（PlatformSDK-*.dmp）：几百 KB 一个，是本机调试痕迹不是源码
*.dmp
crash_task.log
crash_domain.log
crash_recipe.log
crash_startup.log
diag.log
watchdog.log

# Local-only
.workbuddy/
TestImages/VirtualCamera/
notes/

# MVTec AD 子集（几百 MB 的第三方数据，CC BY-NC-SA，不进仓库；用 scripts/prepare_mvtec_subset.py 重建）
TestImages/MVTec-AD/

# 黄金样本库运行产物（每次跑都变，基线才入库）
tests/GoldenSet/last-run.json

# 变异测试产物（每次跑都变；结论已抽到 audit/artifacts-core/evidence/）
StrykerOutput/

# 本地 CI 产物：构建日志每次变，基线文件入库（棘轮的锚点）
artifacts/ci/*.log

# 走查工装每次运行的数据根（db/图片/日志，不进展）
artifacts/runs/

# 汇川 AutoShop 工程目录（PLC 侧临时验证工装，不是本仓库源码；
# 根目录的 test/ 是 AutoShop 建的，跟 tests/ 无关，别混）
/test/
