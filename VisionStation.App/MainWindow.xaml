<Window x:Class="VisionStation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisionStation - 金属零件视觉检测工作站"
        Height="760" Width="1320" MinHeight="550" MinWidth="1000"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ContentControl Grid.Column="0" x:Name="Sidebar" />

        <Grid Grid.Column="1" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 工作区 —— 按导航切换 -->
            <Grid Grid.Row="0">
                <!-- 检测页 -->
                <Grid x:Name="InspectionPage">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,4,0">
                        <ContentControl x:Name="ImagePanel" />
                        <ContentControl x:Name="RoiEditor" Visibility="Collapsed" />
                    </Grid>
                    <Grid Grid.Column="1" Margin="4,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentControl Grid.Row="0" Margin="0,0,0,4" x:Name="ResultPanel" />
                        <ContentControl Grid.Row="1" Margin="0,0,0,4" x:Name="LogPanel" />
                        <ContentControl Grid.Row="2" x:Name="ControlPanel" />
                    </Grid>
                </Grid>

                <!-- 相机页 -->
                <ContentControl x:Name="CameraPage" Visibility="Collapsed" />
                <!-- 其他页在此处继续添加 -->
            </Grid>

            <ContentControl Grid.Row="1" Margin="0,4,0,0" x:Name="StatusBar" />
        </Grid>
    </Grid>
</Window>
