<UserControl x:Class="VisionStation.App.Views.RoiEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VisionStation.App.ViewModels">
    <UserControl.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <!-- 工具栏 -->
        <Border Background="#FAFAFA" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1"
                Padding="6,4" HorizontalAlignment="Right" VerticalAlignment="Top"
                CornerRadius="0,0,0,4" Panel.ZIndex="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ 添加" Command="{Binding AddRoiCommand}"
                        Width="60" Height="24" FontSize="10" Margin="0,0,4,0"
                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" />
                <Button Content="删除" Command="{Binding DeleteSelectedCommand}"
                        Width="50" Height="24" FontSize="10" Margin="0,0,4,0"
                        Background="#E81123" Foreground="White" BorderThickness="0" Cursor="Hand" />
                <Button Content="保存" Command="{Binding SaveToFileCommand}"
                        Width="50" Height="24" FontSize="10" Margin="0,0,4,0"
                        Background="White" BorderBrush="#CCC" BorderThickness="1" Cursor="Hand" />
                <Button Content="加载" Command="{Binding LoadFromFileCommand}"
                        Width="50" Height="24" FontSize="10"
                        Background="White" BorderBrush="#CCC" BorderThickness="1" Cursor="Hand" />
            </StackPanel>
        </Border>

        <!-- 容器：Image + Canvas 叠加 -->
        <Grid x:Name="RootGrid" SizeChanged="OnRootSizeChanged">
            <!-- 原图 -->
            <Image x:Name="EditorImage" Source="{Binding Image}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Canvas 铺满整个 Grid，坐标换算时处理 Uniform 偏移 -->
            <Canvas x:Name="Overlay" Background="Transparent"
                    MouseLeftButtonDown="OnMouseDown"
                    MouseMove="OnMouseMove"
                    MouseLeftButtonUp="OnMouseUp"
                    MouseRightButtonDown="OnRightClick" />

            <!-- ROI 矩形（同样铺满） -->
            <ItemsControl ItemsSource="{Binding Rois}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Background="Transparent" IsHitTestVisible="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas>
                            <Rectangle
                                Canvas.Left="{Binding DisplayX}" Canvas.Top="{Binding DisplayY}"
                                Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"
                                Fill="#220078D4" Stroke="#0078D4" StrokeThickness="2"
                                IsHitTestVisible="False" />
                            <Rectangle
                                Canvas.Left="{Binding DisplayX}" Canvas.Top="{Binding DisplayY}"
                                Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"
                                Fill="Transparent" Stroke="#FFD700" StrokeThickness="3"
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                IsHitTestVisible="False" />
                            <TextBlock
                                Canvas.Left="{Binding DisplayX}" Canvas.Top="{Binding DisplayY}"
                                Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                Foreground="#0078D4" Background="#DDFFFFFF"
                                Padding="2,1" Margin="2,-18,0,0"
                                IsHitTestVisible="False" />
                            <Rectangle
                                Canvas.Left="{Binding DisplayX}" Canvas.Top="{Binding DisplayY}"
                                Width="12" Height="12" Fill="#0078D4"
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                IsHitTestVisible="False">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="{Binding DisplayWidth}" Y="{Binding DisplayHeight}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- 提示 -->
        <Border Background="#BB000000" CornerRadius="4" Padding="10,4"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="8,0,0,8" Panel.ZIndex="10">
            <TextBlock Foreground="#CCC" FontSize="9">
                <Run Text="拖拽画框 | 移动 | 右下角缩放 | Delete/右键删除 | F2退出" />
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
