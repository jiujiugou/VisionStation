(*
================================================================================
 VisionStation PLC 侧配套程序（H5U / AutoShop 4.12 / LiteST）
 作用：给上位机一个「会握手」的假产线，用来验证 ④触发 和 ⑤回写
================================================================================

 怎么用：
   1. AutoShop 新建工程 → 机型选 H5U（如 H5U-1614MTD）
   2. 工程树 → 程序块 → 新建，语言选「结构化文本 / LiteST」
   3. 把本文件从 `(*` 到最后一个 `*)` 全部复制粘贴进去
   4. 编译（F7），然后开仿真运行

 寄存器约定（必须和 VisionStation 的 appsettings.json 完全一致）：
   D100  触发请求      PLC 写 1 → 上位机轮询读到上升沿 → 检测 → 回写 0
   D101  判定结果      上位机写 1=OK / 2=NG → 本程序计数后清零
   D102  心跳          上位机每 100ms 自增 → 本程序看着它变就知道上位机活着

 本程序自用的寄存器（不参与和上位机的通信）：
   D103  OK 计数       ★ 它会涨，就是 ⑤ 回写成功的直接证据
   D104  NG 计数       ★ 同上
   D105  上位机在线    1=心跳在跳 0=心跳停了
   D106  已发触发数    ★ 它会涨，就是 ④ 触发链路的直接证据
   D200  触发节拍计时
   D201  上一次心跳值
   D202  心跳无变化计数

 三个数字怎么看：
   D106 涨 + D103/D104 涨  → 闭环通了（触发和回写都成立）
   D106 只涨到 1 就不动了  → 上位机没起来，或者没在读 D100（D100 卡在 1 上等握手）
   D106 在涨但 D103/D104 不动 → 触发通了、回写没通（查 D101 地址和 PlcResultWriter）
   D105 变 0              → 上位机挂了或 PLC 断线

 注意：节拍用的是扫描周期计数，不是真定时器。数值 2000 在不同程序负载下
       约等于 0.2~2 秒，**只用于验证链路，不能拿来测节拍**。要精确节拍就换成
       系统一秒时钟继电器（H5U 若支持 M8013 的话）。

       调参口诀：**看 D106 涨的速度**。
         D106 涨得比界面出结果还快 → 把 2000 调大（4000 / 8000），否则会丢帧；
         D106 半天不涨             → 调小。
       丢帧在界面上的表现是「丢帧计数」在涨，不是报错。
================================================================================
*)


(* ── 1. 触发节拍：只在 D100 被上位机清 0 之后，才发下一次 ─────────────────
   这是握手的关键：PLC 不会自己把 1 撤掉，必须等上位机回写 0。
   所以上位机不在线时，D100 会一直挂在 1，D106 停在 1 —— 一眼就能看出来。   *)
IF D100 = 0 THEN
    D200 := D200 + 1;
    IF D200 >= 2000 THEN
        D200 := 0;
        D100 := 1;              (* 0→1 上升沿，上位机下一轮轮询就会触发 *)
        D106 := D106 + 1;
    END_IF;
ELSE
    D200 := 0;                  (* 还挂着上一次的请求，等上位机清 *)
END_IF;


(* ── 2. 结果回写：上位机写 1(OK) 或 2(NG)，计数后立刻清零 ───────────────
   清零是必须的：不清的话下一帧的 1 和这一帧的 1 分不出来，
   计数会漏；而且上位机写入时看到非 0 也分不清是新判定还是残留。      *)
IF D101 = 1 THEN
    D103 := D103 + 1;
    D101 := 0;
ELSE
    IF D101 = 2 THEN
        D104 := D104 + 1;
        D101 := 0;
    END_IF;
END_IF;


(* ── 3. 心跳看门狗：D102 一直在变 = 上位机活着 ─────────────────────────
   上位机每轮询一次（默认 100ms）就 +1，所以它 16 位会绕回，
   绕回后数值仍会「变化」，这里的比较用的是「不等」而不是「变大」。

   阈值 3000 必须比心跳间隔宽很多：扫描周期若只有 0.1ms，3000 次 = 300ms，
   刚好等于一个心跳周期，阈值给小了会直接把正常的 100ms 心跳判成断线。    *)
IF D102 <> D201 THEN
    D201 := D102;
    D202 := 0;
    D105 := 1;                  (* 心跳在跳 *)
ELSE
    IF D202 < 3000 THEN
        D202 := D202 + 1;
    ELSE
        D105 := 0;              (* 长时间没变化 → 上位机挂了 *)
    END_IF;
END_IF;
