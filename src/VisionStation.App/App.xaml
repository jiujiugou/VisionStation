<Application x:Class="VisionStation.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VisionStation.App.ViewModels"
             xmlns:views="clr-namespace:VisionStation.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- S6（W-16）：资源按职责拆三份 —— 颜色、转换器、控件样式。
                 以前全堆在 App.xaml，改一个颜色要在 150 行里找；现在主题只改 Theme.xaml。
                 Controls.xaml 内部自带对 Theme.xaml 的合并（解析期需要），
                 所以这里的顺序是 Theme → Converters → Controls。 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
                <ResourceDictionary Source="Resources/Converters.xaml" />
                <ResourceDictionary Source="Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ VM → View 映射（S3b）═══
                 这是 WPF 自带的组合机制：ContentControl 拿到 VM，WPF 自己查表创建视图，
                 并把 DataContext 设成这个 VM。视图因此可以无参构造、不进 DI。
                 用工厂或 DataTemplateSelector 替代它，等于把 WPF 已经做好的事再做一遍。 -->
            <DataTemplate DataType="{x:Type vm:SidebarViewModel}">
                <views:SidebarView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TopBarViewModel}">
                <views:TopBarView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatusBarViewModel}">
                <views:StatusBarView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InspectionPageViewModel}">
                <views:InspectionPageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CameraPageViewModel}">
                <views:CameraPageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryPageViewModel}">
                <views:HistoryPageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AuditPageViewModel}">
                <views:AuditPageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ImagePanelViewModel}">
                <views:ImagePanelView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResultPanelViewModel}">
                <views:ResultPanelView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogPanelViewModel}">
                <views:LogPanelView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ControlPanelViewModel}">
                <views:ControlPanelView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
