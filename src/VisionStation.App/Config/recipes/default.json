{
  "name": "金属垫圈检测",
  "schemaVersion": 2,
  "sensor": { "width": 1280, "height": 1024 },
  "engine": "Vm",
  "vm": {
    "solutionPath": "Config\\solutions\\washer.sol",
    "password": "",
    "procedure": "流程1",
    "imageSourceModule": "图像源1",
    "outputs": [
      {
        "module": "圆查找1",
        "label": "外径",
        "role": "Measure",
        "io": "Radius",
        "ioKind": "Circle",
        "metric": "Radius_px",
        "unit": "px"
      },
      {
        "module": "缺陷检测1",
        "label": "表面缺陷",
        "role": "Defect",
        "io": "BlobCount",
        "ioKind": "Float",
        "metric": "DefectCount"
      }
    ]
  },
  "onnx": {
    "modelPath": "models\\neu-det.onnx",
    "confidence": 0.25,
    "nms": 0.45,
    "maxDetections": 100,
    "classes": [
      "crazing",
      "inclusion",
      "patches",
      "pitted_surface",
      "rolled-in_scale",
      "scratches"
    ]
  }
}
