<Window x:Class="VisionStation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisionStation - 金属零件视觉检测工作站"
        Height="760" Width="1320" MinHeight="550" MinWidth="1000"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">

    <!-- 版面：顶栏横跨全宽，其下才是侧边栏 + 内容 + 状态栏。
         顶栏之所以放在侧边栏外面，是因为侧边栏会随模式收起/展开，
         而"配方、相机、PLC 在不在"这些信息不该跟着一起藏起来。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0" Content="{Binding TopBar}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Content="{Binding Sidebar}" />

            <Grid Grid.Column="1" Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 工作区：内容由导航决定，窗口不认识任何页面 -->
                <ContentControl Grid.Row="0" Content="{Binding CurrentPage}" />

                <ContentControl Grid.Row="1" Margin="0,4,0,0" Content="{Binding StatusBar}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
