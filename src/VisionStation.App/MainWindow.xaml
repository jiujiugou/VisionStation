<Window x:Class="VisionStation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisionStation - 金属零件视觉检测工作站"
        Height="760" Width="1320" MinHeight="550" MinWidth="1000"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <!-- F2 挂在窗口上而不是页面里：快捷键要跟窗口走。
             焦点在侧边栏时，页面上的 InputBinding 收不到按键。 -->
        <KeyBinding Key="F2" Command="{Binding ToggleRoiEditorCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ContentControl Grid.Column="0" Content="{Binding Sidebar}" />

        <Grid Grid.Column="1" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 工作区：内容由导航决定，窗口不认识任何页面 -->
            <ContentControl Grid.Row="0" Content="{Binding CurrentPage}" />

            <ContentControl Grid.Row="1" Margin="0,4,0,0" Content="{Binding StatusBar}" />
        </Grid>
    </Grid>
</Window>
