<!--
    主题资源（S6 / W-16）：颜色只在这里定义一次，视图一律用命名资源引用。
    改主题 = 改这个文件；视图里不再出现十六进制色值。

    命名约定：
      - 语义名（Bg / CardBg / Accent / Ok / Ng）优先于色值名；
      - OnDark 后缀 = 深色背景上的前景色（状态栏那类）；
      - Soft 后缀 = 低透明度叠加色（选中框填充）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 品牌色 -->
    <SolidColorBrush x:Key="Bg"          Color="#F3F3F3" />
    <SolidColorBrush x:Key="CardBg"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder"  Color="#E1E1E1" />
    <SolidColorBrush x:Key="Accent"      Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHover" Color="#106EBE" />
    <SolidColorBrush x:Key="AccentSoft"  Color="#220078D4" />

    <!-- 判定色 -->
    <SolidColorBrush x:Key="Ok"     Color="#107C10" />
    <SolidColorBrush x:Key="OkBg"   Color="#DFF6DD" />
    <SolidColorBrush x:Key="Ng"     Color="#E81123" />
    <SolidColorBrush x:Key="NgBg"   Color="#FDE7E9" />
    <SolidColorBrush x:Key="Neutral" Color="#888888" />

    <!-- 文本 -->
    <SolidColorBrush x:Key="TextPrimary"   Color="#1E1E1E" />
    <SolidColorBrush x:Key="TextSecondary" Color="#555555" />
    <SolidColorBrush x:Key="TextMuted"     Color="#888888" />

    <!-- 面板与列表 -->
    <SolidColorBrush x:Key="SubtleBg"          Color="#F8F9FA" />
    <SolidColorBrush x:Key="RowAltBg"          Color="#F5F5F5" />
    <SolidColorBrush x:Key="ToolbarBg"         Color="#FAFAFA" />
    <SolidColorBrush x:Key="HoverBg"           Color="#E0E0E0" />
    <SolidColorBrush x:Key="ImagePlaceholder"  Color="#EAEAEA" />
    <SolidColorBrush x:Key="InputBorder"       Color="#CCCCCC" />

    <!-- 深色侧边栏 -->
    <SolidColorBrush x:Key="SidebarBg"     Color="#2C2C2C" />
    <SolidColorBrush x:Key="SidebarHover"  Color="#3A3A3A" />

    <!-- 顶栏（2026-10-24 运行模式改造）-->
    <SolidColorBrush x:Key="TopBarBg"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="TopBarBorder" Color="#E1E1E1" />

    <!--
        图像检视底 —— 故意用深色。
        工业视觉惯例：暗底能压掉屏幕和车间的环境反光，缺陷与背景的对比度比浅底高一档。
        这不是"暗色主题"，是检视区专用的画布色，界面其余部分仍是浅色。
    -->
    <SolidColorBrush x:Key="ImageCanvasBg" Color="#2C2C2A" />
    <SolidColorBrush x:Key="ImageCanvasFg" Color="#D3D1C7" />

    <!-- 告警色：需要人处理但不停机，故介于 OK 与 NG 之间 -->
    <SolidColorBrush x:Key="Warn"       Color="#854F0B" />
    <SolidColorBrush x:Key="WarnBg"     Color="#FFF4CE" />
    <SolidColorBrush x:Key="WarnBorder" Color="#F0C36D" />

    <!-- 指标卡底 -->
    <SolidColorBrush x:Key="MetricBg" Color="#F6F7F8" />

    <!-- 覆盖层与标注 -->
    <SolidColorBrush x:Key="ScrimBg"          Color="#BB000000" />
    <SolidColorBrush x:Key="OverlayTextBg"    Color="#DDFFFFFF" />
    <SolidColorBrush x:Key="SelectionStroke"  Color="#FFD700" />

    <!-- 急停按钮 -->
    <SolidColorBrush x:Key="EStopBorder" Color="#A00C18" />

    <!-- 深色背景上的状态色（状态栏） -->
    <SolidColorBrush x:Key="StatusOkOnDark" Color="#6ECF6E" />
    <SolidColorBrush x:Key="StatusNgOnDark" Color="#FF6B6B" />

</ResourceDictionary>
