<UserControl x:Class="VisionStation.App.Views.AuditPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VisionStation.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AuditPageViewModel, IsDesignTimeCreatable=False}">

    <!--
        审计查询页：只读。
        审计是历史事实，界面上不提供任何修改/删除入口 —— 能改审计的系统等于没有审计。
    -->
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ 过滤条 ═══ -->
        <Border Style="{StaticResource PanelCard}" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="审计流水" Style="{StaticResource PanelTitle}"
                           VerticalAlignment="Center" />

                <ComboBox Grid.Column="1" Width="100" Height="26" Margin="16,0,0,0"
                          VerticalContentAlignment="Center" FontSize="11.5"
                          ItemsSource="{Binding Ranges}"
                          SelectedItem="{Binding SelectedRange}"
                          ToolTip="时间范围（按自然日算，不是过去 24 小时）" />

                <ComboBox Grid.Column="2" Width="112" Height="26" Margin="8,0,0,0"
                          VerticalContentAlignment="Center" FontSize="11.5"
                          ItemsSource="{Binding Actions}"
                          SelectedItem="{Binding SelectedAction}"
                          ToolTip="按动作类型过滤" />

                <TextBox Grid.Column="3" Width="116" Height="26" Margin="8,0,0,0"
                         Padding="6,0" VerticalContentAlignment="Center" FontSize="11.5"
                         Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}"
                         BorderBrush="{StaticResource InputBorder}"
                         ToolTip="按用户名过滤，留空为全部" />

                <Button Grid.Column="4" Content="查询" Width="62" Height="26"
                        Margin="8,0,0,0" FontSize="11.5"
                        Style="{StaticResource MinorButton}"
                        Command="{Binding RefreshCommand}" />

                <TextBlock Grid.Column="6" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource TextMuted}"
                           Text="红色为被拒绝的操作" />
            </Grid>
        </Border>

        <!-- ═══ 表格 ═══ -->
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Border Background="{StaticResource SubtleBg}" Padding="10,6"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="168" />
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="时间" FontSize="11" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Grid.Column="1" Text="用户" FontSize="11" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Grid.Column="2" Text="角色" FontSize="11" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Grid.Column="3" Text="动作" FontSize="11" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Grid.Column="4" Text="对象" FontSize="11" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Grid.Column="5" Text="变化" FontSize="11" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Grid.Column="6" Text="结果" FontSize="11" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Grid.Column="7" Text="说明" FontSize="11" Foreground="{StaticResource TextMuted}" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,4"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="168" />
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                                   FontFamily="Consolas" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1" Text="{Binding UserName}"
                                                   FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding UserName}" />

                                        <TextBlock Grid.Column="2" Text="{Binding UserRole}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="3" Text="{Binding ActionText}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="4" Text="{Binding Target}"
                                                   FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding Target}" />

                                        <TextBlock Grid.Column="5" Text="{Binding ChangeText}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding ChangeText}" />

                                        <!-- 结果列：被拒绝要跳出来。
                                             这是全表最该被看见的一列 —— 一条 Denied 意味着有人在越界尝试 -->
                                        <TextBlock Grid.Column="6" Text="{Binding ResultText}"
                                                   FontSize="11.5" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDenied}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Ng}" />
                                                            <Setter Property="FontWeight" Value="Medium" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="7" Text="{Binding Detail}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextMuted}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding Detail}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空态：和"有记录但都在下面"区分开 —— 空表必须说明是"没查到"还是"还没查" -->
                <TextBlock Grid.Row="1" Text="{Binding StatusText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource TextMuted}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 统计条 -->
                <Border Grid.Row="2" Background="{StaticResource SubtleBg}" Padding="10,5"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
