<UserControl x:Class="VisionStation.App.Views.CameraPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VisionStation.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CameraPageViewModel, IsDesignTimeCreatable=False}">
    <Grid Background="{StaticResource Bg}">
        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                CornerRadius="4" Padding="24" Margin="40"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="420">
            <StackPanel>
                <TextBlock Text="相机管理" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" />

                <!-- 状态卡片 -->
                <Border Background="{StaticResource SubtleBg}" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="12" Height="12" Grid.Column="0"
                                 VerticalAlignment="Top" Margin="0,6,12,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#CCC" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CameraStatus}" Value="就绪">
                                            <Setter Property="Fill" Value="{StaticResource Ok}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding CameraType}" FontSize="14"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding CameraStatus}" FontSize="12"
                                       Foreground="#888" Margin="0,2,0,0" />
                            <TextBlock FontSize="11" Foreground="#AAA" Margin="0,4,0,0">
                                <Run Text="已采:" /><Run Text="{Binding FrameCount}" /><Run Text=" 帧 · " />
                                <Run Text="{Binding CameraPath}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 模式切换 -->
                <TextBlock Text="切换相机" FontSize="13" FontWeight="SemiBold"
                           Foreground="#555" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding Modes}"
                              SelectedItem="{Binding SelectedMode}"
                              Height="32" FontSize="12"
                              Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="应用切换"
                            Command="{Binding ApplySwitchCommand}"
                            Width="90" Height="32"
                            Background="{StaticResource Accent}" Foreground="White"
                            FontSize="11" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand" />
                </Grid>

                <!-- 重连按钮 -->
                <Button Content="重新连接" Command="{Binding ReconnectCameraCommand}"
                        Width="90" Height="30" HorizontalAlignment="Right"
                        Background="{StaticResource CardBg}" Foreground="#555"
                        BorderBrush="#CCC" BorderThickness="1"
                        FontSize="11" Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
