<UserControl x:Class="VisionStation.App.Views.ControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VisionStation.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ControlPanelViewModel, IsDesignTimeCreatable=False}">

    <!--
        控制条（2026-10-24 改造）：竖版操作卡 → 图像下方的一横条。

        为什么改：
        原来这一整块（开始/停止/自动/急停/四个维护按钮）占掉右栏三分之一高度，
        而它真正高频的只有四个：开始、停止、自动、急停。
        现在把高频的摊平在图像下面（视线不离图就能按），
        低频的四个维护动作收进「维护」折叠区 —— 不删，但要主动点开才占地方。

        急停的规矩不变：永远是红的、独立一块、和"停止"拉开距离。
        误把停止当急停，和找不到急停，都是产线上会出事的错。
    -->
    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
            BorderThickness="1" CornerRadius="4" Padding="8,6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ 主控行 ═══ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 高频三键。一键完成，不弹确认 —— 这是"高频要一键"那条铁律 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="开始检测"
                            Command="{Binding StartDetectionCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="32" MinWidth="88" Margin="0,0,4,0" />
                    <Button Content="停止"
                            Command="{Binding StopCommand}"
                            Style="{StaticResource StopButton}"
                            Height="32" MinWidth="64" Margin="0,0,4,0" />
                    <Button Command="{Binding ToggleAutoModeCommand}"
                            Style="{StaticResource AutoModeButton}"
                            Height="32" MinWidth="92"
                            AutomationProperties.Name="切换自动模式">
                        <StackPanel Orientation="Horizontal">
                            <!-- 圆点直接进按钮内容，不再用绝对定位叠一层 —— 那个写法窗口一缩放就跑偏 -->
                            <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                                     Fill="{Binding IsAutoMode, Converter={StaticResource BoolToCameraColor}}" />
                            <TextBlock Text="{Binding AutoButtonText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 右：急停。独立、红色、贴着右边缘，和停止拉开距离 -->
                <Button Grid.Column="1" Content="急 停"
                        Command="{Binding EmergencyStopCommand}"
                        Style="{StaticResource EStopButton}"
                        Height="32" MinWidth="76" Padding="10,0"
                        BorderThickness="2" />
            </Grid>

            <!-- ═══ 维护区（默认收起）═══
                 2026-10-27：原来这里还有「重载流程」「扫描输出」两个按钮，已删除。
                 两个都建立在 VM SDK 上，而 SDK 已随相机层移除（改走 TCP 收结果）：
                 重载的实现恒返回 null（界面却报"已重载"，是假成功），
                 扫描的接口零实现（点了只提示不可用）。
                 流程归 VM 客户端管，改完在 VM 里重跑，本程序没有可重载、可扫描的资源。
                 留着按钮比没有按钮更容易让人以为程序坏了。
                 现在只剩「清空」——它只清屏，不动任何配置与数据。 -->
            <Expander Grid.Row="1" Header="维护" IsExpanded="False" Margin="0,6,0,0"
                      FontSize="10" Foreground="{StaticResource TextMuted}"
                      AutomationProperties.Name="展开维护操作">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="清空" Command="{Binding ClearAllCommand}"
                            Style="{StaticResource MinorButton}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="清空显示"
                            ToolTip="清掉眼前的结论、计数与日志（库里的记录不受影响）" />
                </Grid>
            </Expander>
        </Grid>
    </Border>
</UserControl>
