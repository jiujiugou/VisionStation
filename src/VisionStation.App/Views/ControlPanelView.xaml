<UserControl x:Class="VisionStation.App.Views.ControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VisionStation.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ControlPanelViewModel, IsDesignTimeCreatable=False}">
    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
            CornerRadius="4" Padding="10">
        <StackPanel>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="操作" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,4,0"
                             Fill="{Binding CameraOnline, Converter={StaticResource BoolToCameraColor}}" />
                    <TextBlock FontSize="10" Foreground="#888">
                        <Run Text="相机就绪" />
                        <Run Text="  计数 " />
                        <Run Text="{Binding FrameCount}" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="开始检测"
                        Command="{Binding StartDetectionCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,3,0" />
                <Button Grid.Column="1" Content="停止"
                        Command="{Binding StopCommand}"
                        Style="{StaticResource StopButton}" Margin="2,0,0,0" />
            </Grid>

            <Grid Margin="0,0,0,8">
                <Ellipse x:Name="AutoDot" Width="7" Height="7"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Margin="44,0,0,0" Panel.ZIndex="1"
                         Fill="{Binding IsAutoMode, Converter={StaticResource BoolToCameraColor}}" />
                <Button Content="{Binding AutoButtonText}"
                        Command="{Binding ToggleAutoModeCommand}"
                        Style="{StaticResource AutoModeButton}" />
            </Grid>

            <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,0,0,8" />

            <Button Content="急 停" Command="{Binding EmergencyStopCommand}"
                    Style="{StaticResource EStopButton}" Margin="0,0,0,8" />

            <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,0,0,8" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="重新连接" Command="{Binding ReconnectCommand}"
                        Style="{StaticResource MinorButton}" Margin="0,0,2,0" />
                <Button Grid.Column="1" Content="清空" Command="{Binding ClearAllCommand}"
                        Style="{StaticResource MinorButton}" Margin="2,0,2,0" />
                <Button Grid.Column="2" Content="保存图片" Command="{Binding SaveImageCommand}"
                        Style="{StaticResource MinorButton}" Margin="2,0,0,0" />
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
