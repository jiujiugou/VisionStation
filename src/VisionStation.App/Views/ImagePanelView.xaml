<UserControl x:Class="VisionStation.App.Views.ImagePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VisionStation.App.ViewModels"
             Focusable="True" KeyDown="OnKeyDown"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ImagePanelViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <Style x:Key="ImageTabStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="14,5" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="Foreground" Value="#555" />
                        <Setter Property="Background" Value="{StaticResource ImagePlaceholder}" />
                        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                        <Setter Property="BorderThickness" Value="1,1,1,0" />
                        <Setter Property="Margin" Value="-1,0,0,0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4,4,0,0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource CardBg}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab 栏 -->
        <ListBox Grid.Row="0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                 Style="{StaticResource ImageTabStyle}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 图像显示区：支持缩放+平移。
             底色用 ImageCanvasBg（专用深色画布），不再借用 TextPrimary ——
             以前是"碰巧也是深色所以拿来用"，改个文字颜色就会把图像区一起改掉。 -->
        <Border Grid.Row="1" Background="{StaticResource ImageCanvasBg}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="0,4,4,4"
                ClipToBounds="True"
                MouseWheel="OnMouseWheel"
                MouseLeftButtonDown="OnMouseDown"
                MouseMove="OnMouseMove"
                MouseLeftButtonUp="OnMouseUp">
            <Grid x:Name="ImageHost">
                <Image x:Name="ImageDisplay" Source="{Binding CurrentImage}"
                       Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="PanTransform" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <!-- NG 保持角标：主图在 NG 之后会停 2 秒不换。
                     不标出来，操作员看到画面不动会以为程序卡死 —— 必须说明"这是设计，不是故障"。 -->
                <Border Panel.ZIndex="99" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="8,8,0,0" CornerRadius="4" Padding="8,4"
                        Background="#D0A32D2D" BorderBrush="#80F09595" BorderThickness="1"
                        Visibility="{Binding IsNgHeld, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="NG 保持中 · 下一件到达后更新" FontSize="11" Foreground="#FFEDED" />
                </Border>

                <!-- NG 缩略回看：操作员发现 NG 要叫人来看，但下一件一来主图就换了。
                     这里**不阻塞产线**（库照记、PLC 照回写），只把最近一张 NG 留一份缩略图。
                     点缩略图本身也能切换，不必去点小按钮 —— 车间里手上有油，按钮越大越好点。 -->
                <Border Panel.ZIndex="99" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,8,8" CornerRadius="6" Padding="6"
                        Background="#CC1E1E1E" BorderBrush="#60FFFFFF" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRecentNg}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="3" ClipToBounds="True" Cursor="Hand"
                                ToolTip="点一下看这张 NG 的标注图">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding ToggleNgReviewCommand}" />
                            </Border.InputBindings>
                            <Image Source="{Binding RecentNgImage}" Width="96" Height="72"
                                   Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RecentNgText}" FontSize="11" Foreground="#FFB4B4" />
                            <Button Margin="0,5,0,0" Padding="8,1" FontSize="11" Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource MinorButton}"
                                    Content="{Binding NgReviewButtonText}"
                                    Command="{Binding ToggleNgReviewCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 空态：没有图像时这里原本就是一块纯黑，谁看都以为程序坏了。
                     现在分三层说清 —— 什么状态 / 为什么没图 / 该去做什么。

                     三层缺一不可：只写"没有图像"等于什么都没说，因为
                     "VM 没给路径""路径不存在""读图失败"在屏幕上长得一模一样，
                     处理方式却完全不同（去 VM 配 / 查盘符 / 查权限）。

                     这里坚决不显示上一帧的图：留旧图会让人拿上一件的图当这一件，
                     照错图判断比看黑屏危险得多。 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="520" IsHitTestVisible="False"
                            Panel.ZIndex="98">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{Binding EmptyTitle}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="14" Foreground="#9A9A9A" />

                    <TextBlock Text="{Binding EmptyDetail}"
                               Margin="0,10,0,0"
                               TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="12" Foreground="#757575" />

                    <TextBlock Text="{Binding EmptyAction}"
                               Margin="0,16,0,0"
                               TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="12" Foreground="#5DCAA5"
                               Visibility="{Binding HasEmptyAction, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- 鼠标坐标 + 缩放级别（左下角浮层） -->
                <Border Background="{StaticResource ScrimBg}" CornerRadius="3" Padding="8,3"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="6,0,0,6" Panel.ZIndex="99">
                    <TextBlock x:Name="CoordLabel" Foreground="#CCC" FontSize="10"
                               FontFamily="Consolas" Text="(0,0) px | 1.0x" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
