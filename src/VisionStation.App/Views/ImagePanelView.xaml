<UserControl x:Class="VisionStation.App.Views.ImagePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VisionStation.App.ViewModels"
             Focusable="True" KeyDown="OnKeyDown"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ImagePanelViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <Style x:Key="ImageTabStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="14,5" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="Foreground" Value="#555" />
                        <Setter Property="Background" Value="{StaticResource ImagePlaceholder}" />
                        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                        <Setter Property="BorderThickness" Value="1,1,1,0" />
                        <Setter Property="Margin" Value="-1,0,0,0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4,4,0,0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource CardBg}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab 栏 -->
        <ListBox Grid.Row="0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                 Style="{StaticResource ImageTabStyle}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 图像显示区：支持缩放+平移。
             底色用 ImageCanvasBg（专用深色画布），不再借用 TextPrimary ——
             以前是"碰巧也是深色所以拿来用"，改个文字颜色就会把图像区一起改掉。 -->
        <Border Grid.Row="1" Background="{StaticResource ImageCanvasBg}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="0,4,4,4"
                ClipToBounds="True"
                MouseWheel="OnMouseWheel"
                MouseLeftButtonDown="OnMouseDown"
                MouseMove="OnMouseMove"
                MouseLeftButtonUp="OnMouseUp">
            <Grid x:Name="ImageHost">
                <Image x:Name="ImageDisplay" Source="{Binding CurrentImage}"
                       Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="PanTransform" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <!-- 空态说明：没有图像时这里原本是一块黑，谁都以为程序坏了。
                     VM 模式下本来就不采图，必须写清楚"图在平台那边"。 -->
                <TextBlock Text="{Binding EmptyHint}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="13" Foreground="#8A8A8A"
                           IsHitTestVisible="False"
                           Panel.ZIndex="98">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 鼠标坐标 + 缩放级别（左下角浮层） -->
                <Border Background="{StaticResource ScrimBg}" CornerRadius="3" Padding="8,3"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="6,0,0,6" Panel.ZIndex="99">
                    <TextBlock x:Name="CoordLabel" Foreground="#CCC" FontSize="10"
                               FontFamily="Consolas" Text="(0,0) px | 1.0x" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
