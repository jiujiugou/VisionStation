<UserControl x:Class="VisionStation.App.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="52" Background="#2C2C2C">
    <UserControl.Resources>
        <Style x:Key="NavListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="38" />
                        <Setter Property="Height" Value="38" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Foreground" Value="#999" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="0"
                                            ToolTip="{Binding Label}">
                                        <Path Data="{Binding Geometry}"
                                              Fill="{TemplateBinding Foreground}"
                                              Width="18" Height="18"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#3A3A3A" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#0078D4" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="border" Property="Background" Value="#106EBE" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 上部导航 (4个) -->
        <ListBox x:Name="TopNav" Grid.Row="0" ItemsSource="{Binding TopItems}"
                 Style="{StaticResource NavListBox}" SelectedIndex="0"
                 Margin="0,6,0,0"
                 SelectionChanged="OnSelectionChanged" />

        <!-- 自动运行指示灯（space区域中央） -->
        <Ellipse Grid.Row="1" Width="8" Height="8" Fill="#107C10"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,12"
                 Visibility="{Binding IsDimmed, Converter={StaticResource BoolToVis}}" />

        <!-- 下部导航 (4个) -->
        <ListBox x:Name="BottomNav" Grid.Row="2" ItemsSource="{Binding BottomItems}"
                 Style="{StaticResource NavListBox}"
                 Margin="0,0,0,8"
                 SelectionChanged="OnSelectionChanged" />
    </Grid>
</UserControl>
