<UserControl x:Class="VisionStation.App.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VisionStation.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StatusBarViewModel, IsDesignTimeCreatable=False}">
    <Border Background="{StaticResource TextPrimary}" CornerRadius="3" Padding="12,5" Height="26">
        <Grid>
            <!-- 左侧组 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Ellipse Width="7" Height="7" Fill="{StaticResource Ok}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding StatusText}" Foreground="#CCC" FontSize="11" />

                <TextBlock Text="PLC" Foreground="#888" FontSize="11" Margin="14,0,0,0" />
                <!-- Text 绑的是"颜色"，Foreground 才是画颜色的地方。
                     之前写成 Text="{Binding PlcOnline, Converter=...}"，
                     运行时直接把 SolidColorBrush.ToString() 印在了状态栏上（"#FF6EBFEF"）。 -->
                <TextBlock Text="●"
                           Foreground="{Binding PlcOnline, Converter={StaticResource BoolToOnlineColor}}"
                           FontSize="11" Margin="4,0,0,0" />

                <TextBlock Text="Camera" Foreground="#888" FontSize="11" Margin="14,0,0,0" />
                <TextBlock Text="●"
                           Foreground="{Binding CameraOnline, Converter={StaticResource BoolToOnlineColor}}"
                           FontSize="11" Margin="4,0,0,0" />

                <TextBlock FontSize="11" Margin="14,0,0,0">
                    <Run Text="FPS " Foreground="#888" />
                    <Run Text="{Binding Fps}" Foreground="#CCC" />
                </TextBlock>

                <TextBlock FontSize="11" Margin="14,0,0,0">
                    <Run Text="Cycle " Foreground="#888" />
                    <Run Text="{Binding CycleTime}" Foreground="#CCC" />
                </TextBlock>
            </StackPanel>

            <!-- 右侧组 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock FontSize="11" Margin="0,0,14,0">
                    <Run Text="OK " Foreground="#888" />
                    <Run Text="{Binding OkCount}" Foreground="{StaticResource StatusOkOnDark}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock FontSize="11" Margin="0,0,14,0">
                    <Run Text="NG " Foreground="#888" />
                    <Run Text="{Binding NgCount}" Foreground="{StaticResource StatusNgOnDark}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock FontSize="11" Margin="0,0,14,0">
                    <Run Text="CPU " Foreground="#888" />
                    <Run Text="{Binding CpuUsage}" Foreground="#CCC" />
                </TextBlock>
                <TextBlock FontSize="11">
                    <Run Text="内存 " Foreground="#888" />
                    <Run Text="{Binding MemoryUsage}" Foreground="#CCC" />
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
