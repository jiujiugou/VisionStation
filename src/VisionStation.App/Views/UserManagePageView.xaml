<UserControl x:Class="VisionStation.App.Views.UserManagePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VisionStation.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:UserManagePageViewModel, IsDesignTimeCreatable=False}">

    <!--
        用户管理页（F-64）。
        刻意没有"删除"：这套系统里删账号等于让历史审计里的名字变成查无此人，
        所以"删人"的唯一手段是停用 —— 登录被拒、记录全留。见 UserRepository 的接口注释。
    -->
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ 工具栏 ═══ -->
        <Border Style="{StaticResource PanelCard}" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="用户管理" Style="{StaticResource PanelTitle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PasswordRuleText}" Margin="16,0,0,0"
                               VerticalAlignment="Center" FontSize="10.5"
                               Foreground="{StaticResource TextMuted}" />
                </StackPanel>

                <Button Grid.Column="2" Content="刷新" Width="62" Height="26" FontSize="11.5"
                        Style="{StaticResource MinorButton}"
                        Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- ═══ 账号列表 ═══ -->
            <Border Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource SubtleBg}" Padding="10,6"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="用户名" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Grid.Column="1" Text="角色" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Grid.Column="2" Text="状态" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Grid.Column="3" Text="最后登录" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Grid.Column="4" Text="必须改密" FontSize="11" Foreground="{StaticResource TextMuted}" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Users}"
                             SelectedItem="{Binding SelectedUser}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="124" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding UserName}"
                                               FontSize="11.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimary}"
                                               ToolTip="{Binding UserName}" />

                                    <TextBlock Grid.Column="1" Text="{Binding RoleText}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondary}" />

                                    <!-- 停用要一眼看出来：它意味着"这个人现在登不上" -->
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource Ng}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="3" Text="{Binding LastLoginText}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}" />

                                    <TextBlock Grid.Column="4" Text="{Binding MustChangeText}" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MustChangePassword}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ═══ 操作面板 ═══ -->
            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 新建 -->
                        <TextBlock Text="新建账号" Style="{StaticResource PanelTitle}" />

                        <TextBlock Text="用户名" Margin="0,4,0,0" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBox Height="28" Margin="0,4,0,0" Padding="6,0"
                                 VerticalContentAlignment="Center" FontSize="12"
                                 BorderBrush="{StaticResource InputBorder}"
                                 Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="登录名，不区分大小写；建好后不能改名（换人要停用旧的、建新的）" />

                        <TextBlock Text="角色" Margin="0,10,0,0" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" />
                        <ComboBox Height="28" Margin="0,4,0,0" VerticalContentAlignment="Center"
                                  FontSize="12" ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding NewUserRole}" />

                        <TextBlock Text="初始密码" Margin="0,10,0,0" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" />
                        <PasswordBox x:Name="NewPasswordBox" Height="28" Margin="0,4,0,0" Padding="6,0"
                                     VerticalContentAlignment="Center" FontSize="12"
                                     BorderBrush="{StaticResource InputBorder}" />

                        <Button Content="新建账号" Margin="0,10,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnCreateClick" />

                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,14,0,12" />

                        <!-- 对选中账号的操作 -->
                        <TextBlock Text="选中账号" Style="{StaticResource PanelTitle}" />
                        <TextBlock Text="{Binding SelectedUserName}" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="角色" Margin="0,10,0,0" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Height="28" VerticalContentAlignment="Center"
                                      FontSize="12" ItemsSource="{Binding Roles}"
                                      SelectedItem="{Binding EditRole}" />
                            <Button Grid.Column="1" Content="保存角色" Height="28" Width="80"
                                    Margin="6,0,0,0" FontSize="11"
                                    Style="{StaticResource MinorButton}"
                                    Command="{Binding SaveRoleCommand}"
                                    ToolTip="改完要让本人重新登录才生效（会话持有的是登录那一刻的角色）" />
                        </Grid>

                        <TextBlock Text="重置密码" Margin="0,10,0,0" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0" x:Name="ResetPasswordBox" Height="28" Padding="6,0"
                                         VerticalContentAlignment="Center" FontSize="12"
                                         BorderBrush="{StaticResource InputBorder}" />
                            <Button Grid.Column="1" Content="重置" Height="28" Width="68"
                                    Margin="6,0,0,0" FontSize="11"
                                    Style="{StaticResource MinorButton}"
                                    Click="OnResetPasswordClick"
                                    ToolTip="不需要旧密码；重置后本人下次登录必须改密" />
                        </Grid>

                        <Button Content="{Binding ToggleEnabledText}" Margin="0,12,0,0" Height="30"
                                FontSize="11.5" Style="{StaticResource MinorButton}"
                                Command="{Binding ToggleEnabledCommand}"
                                ToolTip="停用后该账号立即无法登录；不提供物理删除（审计要能追溯）" />

                        <!-- 提示行：成功/被拒/失败都写这里，不弹模态框 —— 现场要能回头再看一遍 -->
                        <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" MinHeight="34"
                                   TextWrapping="Wrap" FontSize="11.5" LineHeight="17">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
