<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VisionStation.Core\VisionStation.Core.csproj" />
    <ProjectReference Include="..\VisionStation.Devices\VisionStation.Devices.csproj" />
    <ProjectReference Include="..\VisionStation.Storage\VisionStation.Storage.csproj" />
    <ProjectReference Include="..\VisionStation.Service\VisionStation.Service.csproj" />
    <ProjectReference Include="..\VisionStation.Engines.Vm\VisionStation.Engines.Vm.csproj" />
    <ProjectReference Include="..\VisionStation.Watchdog\VisionStation.Watchdog.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyWatchdog" AfterTargets="Build">
    <Copy SourceFiles="..\VisionStation.Watchdog\bin\$(Configuration)\net8.0-windows\VisionStation.Watchdog.exe"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('..\VisionStation.Watchdog\bin\$(Configuration)\net8.0-windows\VisionStation.Watchdog.exe')" />
  </Target>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\recipes\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- VM 流程文件随程序部署：配方里写的是相对路径（Config\solutions\xxx.sol），
         不复制的话运行时按 exe 目录解析必然找不到 -->
    <None Update="Config\solutions\**\*.sol" Condition="Exists('Config\solutions')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 配方激活指针（S7）：内容就是"当前用哪份配方"。
         不复制的话，bin 里永远没有指针，程序只能靠"文件名排序第一份"兜底 ——
         能跑，但那是巧合而不是意图。 -->
    <None Update="Config\recipes\.active" Condition="Exists('Config\recipes\.active')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 兜底配方内嵌进程序集：磁盘配方损坏时回退到同一份文件，
         杜绝"代码里手抄一份兜底参数"和 default.json 悄悄对不上的问题 -->
    <EmbeddedResource Include="Config\recipes\default.json" />
    <!-- 权重文件不进发布目录：运行时只走 VM，本程序不加载任何模型。
         （2026-10-27 ONNX 推理整条线删除前，这里复制 ../models/*.onnx；
         现在连模型文件本身都已从仓库移除。） -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VisionStation.App.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
