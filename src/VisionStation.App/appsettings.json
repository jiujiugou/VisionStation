{
  "Camera": {
    "Mode": "File",
    "ImageFolder": "TestImages",
    "FileFilter": "*.jpg;*.png;*.bmp",
    "Loop": true
  },
  "Trigger": {
    "TimerIntervalMs": 2000
  },
  "Plc": {
    "Enabled": false,
    "Ip": "127.0.0.1",
    "Port": 502,
    "Station": 1,
    "TriggerAddress": "D100",
    "ResultAddress": "D101",
    "HeartbeatAddress": "D102",
    "PollIntervalMs": 100
  },
  "VmLink": {
    "Enabled": true,
    "Port": 9100,
    "BindAddress": "127.0.0.1",
    "StallTimeoutSeconds": 10
  },
  "Recipe": {
    "Path": "Config\\recipes\\default.json"
  },
  "Storage": {
    "Mode": "All",
    "ImageFolder": "InspectedImages",
    "DbPath": "visionstation.db"
  },
  "Housekeeping": {
    "MemoryCheckIntervalMs": 60000,
    "MaxMemoryMB": 500,
    "DatabaseCleanIntervalMs": 3600000,
    "KeepRecordsDays": 30,
    "ImageRetentionDays": 30,
    "MaxImageFolderMB": 1000
  },
  "Logging": {
    "LogFolder": "D:\\Code\\VisionStation\\logs"
  },
  "Watchdog": {
    "MaxRestarts": 3,
    "WindowMinutes": 10,
    "RestartDelaySeconds": 2,
    "BackoffMaxSeconds": 60
  }
}
