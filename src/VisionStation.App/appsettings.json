{
  "Camera": {
    "Mode": "File",
    "ImageFolder": "TestImages",
    "FileFilter": "*.jpg;*.png;*.bmp",
    "Loop": true
  },
  "Trigger": {
    "Mode": "Manual",
    "TimerIntervalMs": 2000
  },
  "Recipe": {
    "Path": "Config\\recipes\\default.json"
  },
  "Detection": {
    "TemplatePath": "TestImages\\hole_template.png"
  },
  "Storage": {
    "Mode": "All",
    "ImageFolder": "InspectedImages",
    "DbPath": "visionstation.db"
  },
  "Housekeeping": {
    "MemoryCheckIntervalMs": 60000,
    "MaxMemoryMB": 500,
    "DatabaseCleanIntervalMs": 3600000,
    "KeepRecordsDays": 30,
    "ImageRetentionDays": 7,
    "MaxImageFolderMB": 1000
  },
  "Logging": {
    "LogFolder": "Logs"
  }
}
